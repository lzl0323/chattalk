@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  * {
    @apply box-border;
  }
  
  body {
    @apply m-0 p-0 font-sans antialiased;
  }
  
  #app {
    @apply h-screen w-screen;
  }
}

@layer components {
  /* 自定义滚动条 */
  .custom-scrollbar::-webkit-scrollbar {
    @apply w-2;
  }
  
  .custom-scrollbar::-webkit-scrollbar-track {
    @apply bg-gray-100 rounded;
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb {
    @apply bg-gray-300 rounded hover:bg-gray-400;
  }
  
  /* Markdown 样式 */
  .markdown-content {
    @apply text-gray-800 leading-relaxed;
  }
  
  .markdown-content h1,
  .markdown-content h2,
  .markdown-content h3 {
    @apply font-bold mt-4 mb-2;
  }
  
  .markdown-content h1 {
    @apply text-2xl;
  }
  
  .markdown-content h2 {
    @apply text-xl;
  }
  
  .markdown-content h3 {
    @apply text-lg;
  }
  
  .markdown-content ul,
  .markdown-content ol {
    @apply my-2 ml-6;
  }
  
  .markdown-content ul {
    @apply list-disc;
  }
  
  .markdown-content ol {
    @apply list-decimal;
  }
  
  .markdown-content li {
    @apply my-1;
  }
  
  .markdown-content p {
    @apply my-2;
  }
  
  .markdown-content code {
    @apply bg-gray-100 px-1.5 py-0.5 rounded text-sm font-mono text-red-600;
  }
  
  .markdown-content pre {
    @apply bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto my-3;
  }
  
  .markdown-content pre code {
    @apply bg-transparent text-gray-100 p-0;
  }
  
  .markdown-content blockquote {
    @apply border-l-4 border-gray-300 pl-4 italic my-3 text-gray-600;
  }
  
  .markdown-content table {
    @apply border-collapse w-full my-3;
  }
  
  .markdown-content th,
  .markdown-content td {
    @apply border border-gray-300 px-4 py-2;
  }
  
  .markdown-content th {
    @apply bg-gray-100 font-bold;
  }
  
  .markdown-content a {
    @apply text-primary-600 hover:underline;
  }
  
  .markdown-content strong {
    @apply font-bold;
  }
  
  .markdown-content em {
    @apply italic;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}
